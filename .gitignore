# Backend
backend/.venv/
backend/data/
backend/__pycache__/
backend/**/__pycache__/
*.pyc

# Desktop (PySide6 app reuses backend/data/ for its datasets/models too)
desktop/.venv/
desktop/__pycache__/
desktop/**/__pycache__/

# PyInstaller build output (build_exe.py) — regenerate locally, don't commit
desktop/build/
desktop/dist/
desktop/*.spec.bak

# Ultralytics artifacts that may land at repo root if run from there
runs/
*.pt

# Frontend
frontend/node_modules/
frontend/dist/
frontend/.env.local

# OS / editor
.DS_Store
*.log

# PyCharm — keep only the shared run configurations, not machine-specific state
.idea/*
!.idea/runConfigurations/
!.idea/runConfigurations/**
